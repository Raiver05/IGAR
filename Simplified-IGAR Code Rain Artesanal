class matrix_drop:
	
	def __init__(self, x_pos, velocity):
		self.drop_start_time = pygame.time.get_ticks()
		self.drop_delay = 0
		self.current_y_pos = 0
		self.x_pos = x_pos
		self.velocity = velocity
		self.gradient_1 = random.choice(["Ñ", "$", "#", "&", "@"])
		self.gradient_2 = [random.choice(["I", "|", "i"]) for _ in range(3)]
		self.gradient_3 = random.choice([":", ";"])
		self.dead = False
	def update(self):
		current_time = pygame.time.get_ticks()
		if (current_time - self.drop_delay) - self.drop_start_time > 0:
			self.current_y_pos += 1
			self.drop_delay += self.velocity
			self.gradient_1 = random.choice(["Ñ", "$", "#", "&", "@"])
			self.gradient_2 = [random.choice(["I", "|", "i"]) for _ in range(3)]
			self.gradient_3 = random.choice([":", ";"])
		if self.current_y_pos < rows:
			matrix_grid[self.current_y_pos][self.x_pos] = self.gradient_1
		if 0 <= self.current_y_pos - 1 < rows:
			matrix_grid[self.current_y_pos - 1][self.x_pos] = self.gradient_2[0]
		if 0 <= self.current_y_pos - 2 < rows:
			matrix_grid[self.current_y_pos - 2][self.x_pos] = self.gradient_2[1]
		if 0 <= self.current_y_pos - 3 < rows:
			matrix_grid[self.current_y_pos - 3][self.x_pos] = self.gradient_2[2]
		if 0 <= self.current_y_pos - 4 < rows:
			matrix_grid[self.current_y_pos - 4][self.x_pos] = self.gradient_3
		if 0 <= self.current_y_pos - 5 < rows:
			matrix_grid[self.current_y_pos - 5][self.x_pos] = "∙"
		if 0 <= self.current_y_pos - 6 < rows:
			matrix_grid[self.current_y_pos - 6][self.x_pos] = "·"
		if 0 <= self.current_y_pos - 7 < rows:
			matrix_grid[self.current_y_pos - 7][self.x_pos] = "·"
		if self.current_y_pos - 7 >= rows:
			self.dead = True
