# Grilla Cambio
def grid_changed() -> None:
	global grids, current_grid
	if current_grid + 1 < len(grids):
		grids = grids[:current_grid + 1]
	grids.append(copy.deepcopy(grid))
	current_grid = len(grids) - 1

def undo() -> None:
	global grid, current_grid, needs_redraw
	if current_grid > 0:
		current_grid -= 1
		grid = copy.deepcopy(grids[current_grid])
		needs_redraw = True
	else:
		pass

def redo() -> None:
	global grid, current_grid, needs_redraw
	if current_grid < len(grids) - 1:
		current_grid += 1
		grid = copy.deepcopy(grids[current_grid])
		needs_redraw = True
	else:
		pass


# Mueve Celda Seleccionada
def move_selected_cell(direction : str) -> None:
	global selected_cell, needs_redraw
	if selected_cell != None:
		if direction == "up":
			selected_cell = (max(selected_cell[0] - 1, 0), selected_cell[1])
		elif direction == "down":
			selected_cell = (min(selected_cell[0] + 1, rows - 1), selected_cell[1])
		elif direction == "left":
			selected_cell = (selected_cell[0], max(selected_cell[1] - 1, 0))
		elif direction == "right":
			selected_cell = (selected_cell[0], min(selected_cell[1] + 1, cols - 1))
		needs_redraw = True

# Establece Caracter de Celda
def set_selected_cells_value(character : str) -> None:
	global selected_cell, needs_redraw
	if selected_cell != None:
		grid[selected_cell[0]][selected_cell[1]] = character
		selected_cell = (selected_cell[0], min(selected_cell[1] + 1, cols - 1))
		needs_redraw = True
		grid_changed()

# Borra Caracter de Celda
def erase_selected_cells() -> None:
	global selected_cell, needs_redraw
	if selected_cell != None:
		grid[selected_cell[0]][selected_cell[1]] = " "
		needs_redraw = True
		grid_changed()

# Dibuja Caracteres en Pantalla
def draw_ascii() -> None:
	for y in range(rows):
		for x in range(cols):
			cell = grid[y][x]
			if isinstance(cell, str) and cell != " " and cell != "":
				screen.blit(get_text_surface(cell), (x * rect_x, y * rect_y))

def get_text_surface(char : str) -> pygame.Surface:
	if char not in text_cache:
		text_cache[char] = font.render(char, True, (255, 255, 255))
	return text_cache[char]


# Destaca Celda Seleccionada
def handle_highlight_timer() -> None:												# Maneja Contador Destaque Celda
	global highlight_timer, highlight_state, needs_redraw
	if highlight_timer != None:
		current_time = pygame.time.get_ticks()
		if current_time - highlight_timer >= 500:
			highlight_state = 1 - highlight_state
			highlight_timer = current_time
			needs_redraw = True

def highlight_selected_cell() -> None:												# Destaca Celda Seleccionada
	if selected_cell != None:
		rect_area = pygame.Rect(selected_cell[1] * rect_x, selected_cell[0] * rect_y, rect_x, rect_y)
		
		if highlight_state == 1 and screen.get_rect().contains(rect_area):
			sub_surface : pygame.Surface = screen.subsurface(rect_area).copy()
			inverted : pygame.Surface = pygame.Surface((rect_x, rect_y))
			for py in range(rect_y):
				for px in range(rect_x):
					color : pygame.Color = sub_surface.get_at((px, py))
					inv_color : tuple[int, int, int] = (255 - color.r, 255 - color.g, 255 - color.b)
					inverted.set_at((px, py), inv_color)
			screen.blit(inverted, rect_area.topleft)

def	draw_line(first_point : tuple[int], second_point : tuple[int], char : str = "$"):
	if (second_point[1] - first_point[1]) != 0:
		m = (second_point[0] - first_point[0]) / (second_point[1] - first_point[1])
		if m != None and m != 0:
			x_start, x_end = sorted([first_point[1], second_point[1]])
			for x in range(x_start, x_end + 1): 
				y = int(m * (x - first_point[1]) + first_point[0])
				grid[y][x] = char
			y_start, y_end = sorted([first_point[0], second_point[0]])
			for y in range(y_start, y_end + 1): 
				x = int(((y - first_point[0])/m) + first_point[1])
				grid[y][x] = char
			print("S")

def draw_circle():
	for x in range(first_point[1], second_point[1]):
		a = abs(second_point[1] + first_point[1])
		b = abs(second_point[0] + first_point[0])
		y = int((-(x - a)**2 + 16) ** 0.5 + b)
		grid[y][x] = "$"
