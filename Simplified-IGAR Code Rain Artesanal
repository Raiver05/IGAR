					needs_redraw = True
				elif event.key == pygame.K_DELETE:											# Supr
					erase_selected_cells()
					for cell in range(selected_cell[1], cols - 1):
						grid[selected_cell[0]][cell] = grid[selected_cell[0]][cell + 1]
					needs_redraw = True
					grid_changed()
				elif event.key == pygame.K_SPACE:											# Space
					erase_selected_cells()
					move_selected_cell("right")
				elif event.key == pygame.K_UP:
					move_selected_cell("up")						# Up
				elif event.key == pygame.K_DOWN:
					move_selected_cell("down")					# Down
				elif event.key == pygame.K_LEFT:
